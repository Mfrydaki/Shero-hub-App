
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
.env
venv/
ENV/
env/

# Django
db.sqlite3
media/
staticfiles/

# Node / React
node_modules/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# IDEs & Editors
.idea/
.vscode/
*.swp
shero_hub_backup_*/
